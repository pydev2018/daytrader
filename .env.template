# MT5 connection (blank uses currently logged-in terminal)
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=60000

# Runtime
LOG_LEVEL=INFO
MAGIC_NUMBER=929292
SYMBOLS=EURCAD
TIMEFRAME=M5
BAR_COUNT=500
LOOP_SECONDS=2.0

# Phase-offset zipper geometry
LOT_SIZE=0.01
START_WITH_ANCHOR=true
ANCHOR_LOT_MULT=1.0
MAX_RUNGS_PER_SIDE=6
OFFSET_RATIO=0.5
STEP_ATR_MULT=0.9
STEP_SPREAD_MULT=12.0
MIN_STEP_TICKS=5
RECENTER_MOVE_STEPS=1.5

# Trend / exhaustion detection
ATR_PERIOD=14
ADX_PERIOD=14
TREND_FAST_EMA=34
TREND_SLOW_EMA=89
TREND_ON_ADX=25.0
TREND_OFF_ADX=20.0
EXHAUSTION_CONFIRM_BARS=4
SLOW_TREND_BARS=5
SLOW_TREND_MIN_MOVE_STEPS=1.0

# Risk and cleanup
MAX_SPREAD_PIPS=3.0
MAX_MARGIN_USAGE_PCT=70.0
MAX_DRAWDOWN_PCT=18.0
MAX_NET_DELTA_LOTS=0.50
CLEANUP_CLOSE_COUNT=2
RISK_OFF_UNWIND_PER_CYCLE=2
PROTECT_OSCILLATION_BANK=true

